					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.id) {",
									"    pm.collectionVariables.set('loanId', jsonData.id);",
									"    console.log('Saved loanId: ' + jsonData.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{customerToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"loanType\": \"PERSONAL\",\n  \"amount\": 12000.0,\n  \"tenure\": 12,\n  \"customer\": {\n    \"id\": {{customerId}}\n  }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/loans",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"loans"
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Loan Details by ID",
					"request": {
						"method": "GET",
