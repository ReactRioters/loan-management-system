						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"john_customer\",\n  \"password\": \"custPass123\",\n  \"email\": \"john@example.com\",\n  \"role\": \"ROLE_CUSTOMER\",\n  \"name\": \"John Customer\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"host": [
								"{{baseUrl}}"
