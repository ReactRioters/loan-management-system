					"response": []
				},
				{
					"name": "Login Customer",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('customerToken', jsonData.token);",
									"    console.log('Saved customerToken');",
									"}",
									"if (jsonData.customerId) {",
									"    pm.collectionVariables.set('customerId', jsonData.customerId);",
									"    console.log('Saved customerId: ' + jsonData.customerId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"john_customer\",\n  \"password\": \"custPass123\"\n}"
